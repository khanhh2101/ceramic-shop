# Môi trường Production (Chạy trên máy chủ thực tế)
VITE_API_URL=https://api.yourdomain.com/api
VITE_SIGNALR_URL=https://api.yourdomain.com/hubs
VITE_BASE_URL=https://yourdomain.com

# Cấu hình đăng nhập mạng xã hội (Dành cho production)
# Lấy Client ID tại: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Lấy App ID tại: https://developers.facebook.com/
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
